@@ -337,4 +337,41 @@ public class GlassFrameDrawable extends DrawableWrapper {
     public static Drawable wrapPopup(Drawable inner) {
         return new GlassFrameDrawable(inner, 10);
     }
+
+    /** UZ: faqat qirra chizadigan drawable (video/PiP oynalari ustiga). EN: a rim-only drawable (over video/PiP windows). RU: drawable tolko s obodkom. */
+    public static Drawable rimOnly(final float radiusDp) {
+        return new Drawable() {
+            private final RectF r = new RectF();
+
+            @Override
+            public void draw(Canvas canvas) {
+                if (capturing) {
+                    return;
+                }
+                final Rect b = getBounds();
+                if (b.width() < dp(8) || b.height() < dp(8)) {
+                    return;
+                }
+                try {
+                    r.set(b);
+                    final float rad = Math.min(dp(radiusDp), Math.min(r.width(), r.height()) / 2f);
+                    QrGlass.drawRim(canvas, r, rad, QrGlass.RIM_BIG, 1f);
+                } catch (Throwable ignore) {
+                }
+            }
+
+            @Override
+            public void setAlpha(int alpha) {
+            }
+
+            @Override
+            public void setColorFilter(ColorFilter colorFilter) {
+            }
+
+            @Override
+            public int getOpacity() {
+                return android.graphics.PixelFormat.TRANSLUCENT;
+            }
+        };
+    }
 }
