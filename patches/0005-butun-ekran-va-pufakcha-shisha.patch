+    private static final RectF SCREEN_RECT = new RectF();
+
+    /** UZ: Butun ekran ramkasi (yuqori yaltiroq + qirra). EN: whole-screen frame (top sheen + rim). RU: ramka vsego ekrana. */
+    public static void drawScreenFrame(Canvas canvas, int width, int height) {
+        if (width <= 0 || height <= 0) {
+            return;
+        }
+        try {
+            SCREEN_RECT.set(dp(1), dp(1), width - dp(1), height - dp(1));
+            final float r = dp(24);
+            QrGlass.drawSheenRound(canvas, SCREEN_RECT, r, false, 0.7f);
+            QrGlass.drawRim(canvas, SCREEN_RECT, r, QrGlass.RIM_BIG, 0.5f);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    /** UZ: Xabar pufakchasi qirrasi. EN: chat bubble rim. RU: obodok puzyrya soobshcheniya. */
+    public static void drawBubbleRim(Canvas canvas, Rect bounds) {
+        if (bounds == null || bounds.height() < dp(24) || bounds.width() < dp(24)) {
+            return;
+        }
+        try {
+            SCREEN_RECT.set(bounds.left + dp(2), bounds.top + dp(2), bounds.right - dp(2), bounds.bottom - dp(2));
+            QrGlass.drawRim(canvas, SCREEN_RECT, dp(14), QrGlass.RIM_BIG, 0.55f);
+        } catch (Throwable ignore) {
+        }
+    }
