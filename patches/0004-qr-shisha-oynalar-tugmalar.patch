+package org.telegram.ui.Components;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.DrawableWrapper;
+
+import org.telegram.ui.QrShare.QrGlass;
+
+/**
+ * UZ: Ichki fon (dialog, sheet, menyu) ustiga QR ekranidagi shisha: yaltiroq qatlam + qirra (rim). Android 10+ da ishlaydi.
+ * EN: The QR screen glass (top sheen + baked rim) drawn over an inner background (dialog, sheet, popup). Android 10+.
+ * RU: Steklo ekrana QR (blik + obodok) poverkh vnutrennego fona (dialog, sheet, menyu). Android 10+.
+ */
+public class GlassFrameDrawable extends DrawableWrapper {
+
+    private final float radius;
+    private final boolean radiusIsPx;
+    private final RectF rect = new RectF();
+    private final Rect pad = new Rect();
+    private int alpha = 255;
+
+    public GlassFrameDrawable(Drawable inner, float radiusDp) {
+        this(inner, radiusDp, false);
+    }
+
+    public GlassFrameDrawable(Drawable inner, float radius, boolean radiusIsPx) {
+        super(inner);
+        this.radius = radius;
+        this.radiusIsPx = radiusIsPx;
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        super.draw(canvas);
+        try {
+            final Drawable inner = getDrawable();
+            if (inner == null) {
+                return;
+            }
+            pad.setEmpty();
+            inner.getPadding(pad);
+            final Rect b = getBounds();
+            rect.set(b.left + pad.left, b.top + pad.top, b.right - pad.right, b.bottom - pad.bottom);
+            if (rect.width() < dp(8) || rect.height() < dp(8)) {
+                return;
+            }
+            final float rad = Math.min(radiusIsPx ? radius : dp(radius), Math.min(rect.width(), rect.height()) / 2f);
+            final float a = alpha / 255f;
+            QrGlass.drawSheenRound(canvas, rect, rad, false, a);
+            QrGlass.drawRim(canvas, rect, rad, QrGlass.RIM_BIG, a);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        this.alpha = alpha;
+        super.setAlpha(alpha);
+    }
+
+    @Override
+    public ColorFilter getColorFilter() {
+        final Drawable inner = getDrawable();
+        return inner != null ? inner.getColorFilter() : null;
+    }
+
+    /** UZ: Panel (ActionBar) ostki chizig'i. EN: bottom edge line of a bar. RU: nizhnyaya liniya paneli. */
+    public static void drawBarEdge(Canvas canvas, int width, int height) {
+        if (width <= 0 || height <= 0) {
+            return;
+        }
+        try {
+            final RectF r = AndroidUtilitiesRect.get();
+            final float ext = dp(30);
+            r.set(-ext, -ext, width + ext, height);
+            canvas.save();
+            canvas.clipRect(0, 0, width, height);
+            QrGlass.drawRim(canvas, r, dp(18), QrGlass.RIM_BIG, 0.8f);
+            canvas.restore();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static final class AndroidUtilitiesRect {
+        private static final RectF RECT = new RectF();
+
+        static RectF get() {
+            return RECT;
+        }
+    }
+}
