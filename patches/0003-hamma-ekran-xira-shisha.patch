+
+    /** UZ: sirt ranglarini yarim shaffof qiladi (xira shisha). EN: makes surface colors translucent (frosted glass). RU: delaet poverhnosti poluprozrachnymi. */
+    private static int glassSurface(int key, int color) {
+        if (android.os.Build.VERSION.SDK_INT < 31) {
+            return color;
+        }
+        int alpha;
+        if (key == key_windowBackgroundWhite || key == key_actionBarDefault || key == key_dialogBackground || key == key_chats_menuBackground) {
+            alpha = 0xB8;
+        } else if (key == key_windowBackgroundGray || key == key_dialogBackgroundGray || key == key_graySection) {
+            alpha = 0xA8;
+        } else {
+            return color;
+        }
+        return (color & 0x00ffffff) | (alpha << 24);
     }
 
