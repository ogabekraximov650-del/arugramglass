+    private final RectF rect = new RectF();
+
+    public GlassShapeDrawable(RoundRectShape shape, float radius) {
+        super(shape);
+        this.radius = radius;
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        super.draw(canvas);
+        if (!GlassFrameDrawable.isMain() || GlassFrameDrawable.isCapturing() || getPaint().getAlpha() < 24 || getPaint().getShader() != null) {
+            return;
+        }
+        final Rect b = getBounds();
+        if (b.width() < dp(24) || b.height() < dp(24)) {
+            return;
+        }
+        try {
+            rect.set(b);
+            QrGlass.drawRim(canvas, rect, Math.min(radius, Math.min(rect.width(), rect.height()) / 2f), QrGlass.RIM_BIG, 0.6f);
+        } catch (Throwable ignore) {
+        }
+    }
+}
